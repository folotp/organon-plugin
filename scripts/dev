#!/usr/bin/env bash
# Shared development launcher; see docs/development.md and docs/development-architecture.md.
# Resolve this script’s worktree, never another agent’s cwd or the primary checkout.
# Lightweight hooks/diagnostics use the launcher Python; full checks use locked uv.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
# Normalize client startup to the repository root, including subdirectory launches.
# Client trust/permissions remain unchanged; no extra flags are injected.
if [[ "${1:-}" == session ]]; then
    shift
    client="${1:-}"
    case "$client" in
        claude | codex) shift ;;
        *)
            echo 'Usage: scripts/dev session claude|codex [client arguments]' >&2
            exit 2
            ;;
    esac
    exec "$client" "$@"
fi
case "${1:-help}" in
    doctor | worktree | hook | install-hooks | check-staged)
        exec python3 "$root/scripts/dev.py" "$@"
        ;;
    *) exec uv run --locked --project "$root" python "$root/scripts/dev.py" "$@" ;;
esac
